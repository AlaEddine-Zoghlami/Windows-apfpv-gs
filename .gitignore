# build output
build/
build-*/
*.exe
*.o
*.obj

# prebuilt runtime DLLs come from MSYS2/the packager, not the repo
*.dll

# per-machine UI toggles, written at runtime
apfpv_settings.ini

# recordings
apfpv_rec_*.ts
apfpv_rec_*.mp4
records/

# scratch logs and captures. Blanket *.txt because this tree accumulates debug
# dumps (player_*_err.txt, memory_timeline.txt, ...); CMakeLists.txt is re-added
# explicitly since it shares the extension.
*.txt
!CMakeLists.txt
*.log
*.bin
